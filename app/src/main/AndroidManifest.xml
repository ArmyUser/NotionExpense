<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Notion Expense"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- Icona normale dell'app: apre la dashboard. -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="true"
            android:theme="@style/Theme.NotionExpense.Dashboard">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!--
            Quick Add: invariato, stesso nome di componente di prima
            (it.speses22.app/.MainActivity).

            Nessun intent-filter MAIN/LAUNCHER: non deve comparire una seconda
            icona. Resta exported, quindi qualsiasi app di scorciatoie o
            automazione puo' avviarlo esplicitamente per nome di componente.
            Lo shortcut statico dichiarato su DashboardActivity offre lo stesso
            bersaglio a chi sa selezionare gli shortcut invece dei componenti.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/quick_add_short_label"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NotionExpense.Transparent" />

    </application>

</manifest>